generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Material {
  id              Int      @id @default(autoincrement())
  name            String
  unit            String
  quantity        Float
  pricePerUnit    Float
  alertThreshold  Float    @default(5)
  expiryDate      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
    purchases   Purchase[]
}

model Purchase {
  id          Int      @id @default(autoincrement())
  materialId  Int
  material    Material @relation(fields: [materialId], references: [id])
  quantity    Float
  totalPrice  Float
  purchaseDate DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
}
model Doctor {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  createdAt DateTime @default(now())
  sales     Sale[]
    workOrders WorkOrder[]
}

model Sale {
  id           Int      @id @default(autoincrement())
  doctorId     Int
  doctor       Doctor   @relation(fields: [doctorId], references: [id])
  serviceType  String
  price        Float
  cost         Float    @default(0)
  saleDate     DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}
model WorkOrder {
  id           Int       @id @default(autoincrement())
  doctorId     Int
  doctor       Doctor    @relation(fields: [doctorId], references: [id])
  teeth        String[]
  workType     String
  color        String?
  receivedDate DateTime
  deliveryDate DateTime?
  createdAt    DateTime  @default(now())
}